{
  "name": "bookbingo",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --build tsconfig.build.json",
    "build:libs": "tsc --build lib/*/tsconfig.build.json",
    "build:apps": "tsc --build app/web/tsconfig.build.json",
    "typecheck": "tsc --build --noEmit && pnpm --filter @bookbingo/functions exec tsc --noEmit",
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter @bookbingo/web dev",
    "dev:web:emulator": "pnpm --filter @bookbingo/web dev:emulator",
    "dev:web:staging": "pnpm --filter @bookbingo/web dev:staging",
    "dev:web:prod": "pnpm --filter @bookbingo/web dev:prod",
    "deploy:staging": "pnpm --filter @bookbingo/web build:staging && firebase deploy --only hosting,firestore:rules --project staging",
    "deploy:prod": "pnpm --filter @bookbingo/web build:prod && firebase deploy --only hosting,firestore:rules --project prod",
    "deploy:functions:staging": "firebase deploy --only functions --project staging",
    "deploy:functions:prod": "firebase deploy --only functions --project prod",
    "deploy:all:staging": "pnpm --filter @bookbingo/web build:staging && firebase deploy --project staging",
    "deploy:all:prod": "pnpm --filter @bookbingo/web build:prod && firebase deploy --project prod",
    "emulator:start": "firebase emulators:start --project demo-bookbingo --import=./emulator-data --export-on-exit ./emulator-data",
    "emulator:seed": "FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 tsx scripts/seed-emulator.ts",
    "seed:staging": "tsx scripts/seed-staging.ts --project bookbingo-staging",
    "mirror:staging": "tsx scripts/mirror-prod-to-staging.ts",
    "test:integration": "firebase emulators:exec --project demo-bookbingo 'pnpm --filter @bookbingo/web test:integration'",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm test && pnpm run typecheck",
    "dev:local": "concurrently --kill-others --names 'emulator,web' 'pnpm run emulator:start' 'pnpm run dev:web:emulator'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.13.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "^15.26.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.18.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@bookbingo/lib-core": "workspace:*",
    "firebase-admin": "^13.7.0"
  }
}
