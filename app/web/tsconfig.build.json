{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    // Not `dist` — that directory is Vite's build output and the Firebase
    // Hosting public root. Nothing consumes this tsc emit; it is a byproduct
    // of keeping app/web in the project-reference graph.
    "outDir": ".tsbuild",
    "rootDir": "src",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"],
  "exclude": [
    ".tsbuild/**/*",
    "dist/**/*",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "references": [
    { "path": "../../lib/core/tsconfig.build.json" },
    { "path": "../../lib/types/tsconfig.build.json" },
    { "path": "../../lib/util/tsconfig.build.json" }
  ]
}
