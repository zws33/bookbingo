{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // `target` and the unused-code flags are inherited from the root chain so
    // this config and `pnpm run typecheck` cannot disagree about the same
    // files. `lib` is restated to exactly the root value rather than left
    // implicit, so the two are comparable by reading them.
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
