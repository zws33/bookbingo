{
  "name": "@bookbingo/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "dev:staging": "vite --mode staging",
    "dev:prod": "vite --mode prod",
    "build": "pnpm run build:prod",
    "build:staging": "tsc --noEmit -p tsconfig.json && vite build --mode staging",
    "build:prod": "tsc --noEmit -p tsconfig.json && vite build --mode prod",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@bookbingo/lib-types": "workspace:*",
    "@bookbingo/lib-util": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bookbingo/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.3.0",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
