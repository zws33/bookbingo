# ─────────────────────────────────────────────────────────────────────────────
# Local development (recommended)
# ─────────────────────────────────────────────────────────────────────────────
# Use the Firebase emulator instead of real Firebase credentials.
# No setup required — fake values are already in .env.emulator.
# All of these are root scripts; run them from the repo root.
#
#   Both at once: pnpm run dev:local
#   ...or split:  pnpm run emulator:start   (terminal 1)
#                 pnpm run dev:web:emulator (terminal 2)
#   Seed data:    pnpm run emulator:seed
#
# ─────────────────────────────────────────────────────────────────────────────
# Integration tests — no env file needed
# ─────────────────────────────────────────────────────────────────────────────
# `pnpm run test:integration` does NOT read a .env file. The suite performs
# real writes, so its Firebase config is pinned to the emulator in committed
# config instead — see the `env` block in app/web/vitest.config.int.ts.
# A .env.test on your machine cannot redirect it at a real project.
#
# ─────────────────────────────────────────────────────────────────────────────
# Real Firebase project (staging / prod)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.staging or .env.prod and fill in real values.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
