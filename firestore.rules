rules_version = '2';

// No client touches Firestore. Every read and write goes through a callable in
// functions/, which runs with the Admin SDK and so bypasses these rules — see
// docs/functions-data-migration-plan.md.
//
// This denies the client SDK, not the app: the endpoints enforce the rules that
// used to live here (ownership from the auth token), plus the ones that never
// could (tile catalog membership, the per-reading tile cap, one freebie per
// user, and a book that must exist).
//
// A deny-all default is also what makes a new collection safe by construction:
// there is no matcher to forget.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
