# Copy to functions/.env.local. The Firebase emulator loads that file for the
# functions it runs; `pnpm run db:migrate` reads it with --env-file-if-exists.
# Deployed environments get DATABASE_URL as a secret, not from a file.
#
# Matches docker-compose.yaml: port 5433, database bookbingo_test.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bookbingo_test
