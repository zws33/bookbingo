# Copy to functions/.env.local. The Firebase emulator loads that file for the
# functions it runs; `pnpm run db:migrate` reads it with --env-file-if-exists.
# Deployed environments get DATABASE_URL as a secret, not from a file.
#
# Both match docker-compose.yaml: port 5433, database bookbingo_test.

# What the application connects to. The migration scripts do not read it: point
# it at a remote database freely, and pass --database-url to write to that
# database.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bookbingo_test

# What `pnpm run test:db` and the migration scripts connect to by default, and
# the only variable the test harness reads. Separate from DATABASE_URL so the harness —
# which truncates every table between tests — cannot reach whatever the
# application is pointed at.
# The database must also carry the marker set by db/testing/mark-test-database.sql.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/bookbingo_test
